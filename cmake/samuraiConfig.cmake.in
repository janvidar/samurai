@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The samurai target carries these as PUBLIC link dependencies, so consumers
# have to be able to resolve them too.
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)

# zlib and bzip2 are PRIVATE dependencies of the library. The shared library
# absorbs them, but a static archive does not link its dependencies, so they
# appear in the static target's link interface and consumers have to resolve
# them as well.
find_dependency(ZLIB)
find_dependency(BZip2)

# TLS is mandatory and the samurai target carries OpenSSL::SSL as a PUBLIC
# dependency. No version is required here: the library build enforces the
# OpenSSL 3.0 / LibreSSL 3.5 floor, and LibreSSL cannot be version checked
# through find_package(OpenSSL) anyway - it reports itself as 2.0.0.
find_dependency(OpenSSL)

include("${CMAKE_CURRENT_LIST_DIR}/samuraiTargets.cmake")

# Installations may carry the shared library, the static one, or both.
# samurai::samurai always names something usable; samurai::samurai_static is
# only defined when a static library was installed.
if(NOT TARGET samurai::samurai AND TARGET samurai::samurai_static)
    add_library(samurai::samurai ALIAS samurai::samurai_static)
endif()

check_required_components(samurai)
