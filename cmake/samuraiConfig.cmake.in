@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The samurai target carries these as PUBLIC link dependencies, so consumers
# have to be able to resolve them too.
set(THREADS_PREFER_PTHREAD_FLAG ON)
find_dependency(Threads)

if("@SAMURAI_EXPORTED_TLS_PROVIDER@" STREQUAL "OPENSSL")
    find_dependency(OpenSSL 1.0.2)
elseif("@SAMURAI_EXPORTED_TLS_PROVIDER@" STREQUAL "GNUTLS")
    find_dependency(PkgConfig)
    pkg_check_modules(GNUTLS REQUIRED IMPORTED_TARGET gnutls)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/samuraiTargets.cmake")

check_required_components(samurai)
